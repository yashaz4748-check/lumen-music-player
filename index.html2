<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Lumen</title>
  <style>
    :root { --bg:#000; --card:#1c1c1e; --text:#f5f5f7; --muted:#86868b; --red:#fa233b; }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:-apple-system,BlinkMacSystemFont,sans-serif; background:var(--bg); color:var(--text); min-height:100vh; padding:18px 16px 170px; }
    header { display:flex; justify-content:space-between; align-items:flex-end; }
    h1 { font-size:34px; letter-spacing:-1px; }
    .sub { color:var(--muted); font-size:13px; margin-top:4px; }
    label.add, button { background:var(--card); color:#fff; border:0; border-radius:999px; padding:10px 14px; font-weight:650; }
    input[type="file"] { display:none; }
    .hero { margin:22px 0 18px; background:linear-gradient(160deg,#3a1020,#1c1c1e 55%); border-radius:22px; padding:20px; min-height:150px; display:flex; flex-direction:column; justify-content:flex-end; }
    .hero small { color:#ff8a9a; font-weight:700; text-transform:uppercase; font-size:11px; }
    .hero h2 { font-size:26px; margin:6px 0 4px; }
    .section { font-size:20px; font-weight:750; margin:8px 0 12px; }
    .list { display:grid; gap:8px; }
    .track { display:flex; align-items:center; gap:12px; padding:10px; border-radius:14px; }
    .track.active { background:var(--card); }
    .art { width:52px; height:52px; border-radius:10px; flex:0 0 52px; background:linear-gradient(135deg,#ff375f,#bf5af2); }
    .meta { min-width:0; flex:1; }
    .meta b,.now b { display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .meta span,.now span { color:var(--muted); font-size:12px; }
    .player { position:fixed; left:10px; right:10px; bottom:10px; background:rgba(28,28,30,.9); border-radius:20px; padding:12px; }
    .row { display:flex; align-items:center; gap:10px; }
    .now { flex:1; min-width:0; }
    .controls { display:flex; gap:6px; }
    .controls button { width:42px; height:42px; border-radius:50%; background:#2c2c2e; }
    #play { background:var(--red); }
    input[type="range"] { width:100%; margin-top:10px; accent-color:#fff; }
    .empty { color:var(--muted); padding:20px 4px; }
  </style>
</head>
<body>
  <header>
    <div>
      <h1>Listen Now</h1>
      <p class="sub">Your library · ad-free</p>
    </div>
    <label class="add">Add Music
      <input id="files" type="file" accept="audio/*" multiple />
    </label>
  </header>

  <section class="hero">
    <small>Library</small>
    <h2>Play what you own</h2>
    <p class="sub">Phone se gaane add karo. Ads nahi aayenge.</p>
  </section>

  <h3 class="section">Songs</h3>
  <div id="list" class="list">
    <p class="empty">Add Music se mp3 select karo.</p>
  </div>

  <div class="player">
    <div class="row">
      <div class="art"></div>
      <div class="now">
        <b id="title">Not Playing</b>
        <span id="artist">Lumen</span>
      </div>
      <div class="controls">
        <button id="prev" type="button">‹</button>
        <button id="play" type="button">▶</button>
        <button id="next" type="button">›</button>
      </div>
    </div>
    <input id="seek" type="range" min="0" max="100" value="0" />
    <audio id="audio"></audio>
  </div>

  <script>
    const filesInput = document.getElementById("files");
    const listEl = document.getElementById("list");
    const audio = document.getElementById("audio");
    const title = document.getElementById("title");
    const artist = document.getElementById("artist");
    const playBtn = document.getElementById("play");
    const seek = document.getElementById("seek");
    let tracks = [];
    let index = -1;

    filesInput.addEventListener("change", (e) => {
      tracks = [...e.target.files].map(file => ({
        name: file.name.replace(/\.[^/.]+$/, ""),
        url: URL.createObjectURL(file)
      }));
      render();
      if (tracks.length) playAt(0);
    });

    function render() {
      if (!tracks.length) {
        listEl.innerHTML = '<p class="empty">Add Music se mp3 select karo.</p>';
        return;
      }
      listEl.innerHTML = tracks.map((t,i) =>
        `<div class="track ${i===index?'active':''}" data-i="${i}">
          <div class="art"></div>
          <div class="meta"><b>${t.name.replace(/</g,'')}</b><span>On this device</span></div>
        </div>`
      ).join("");
      listEl.querySelectorAll(".track").forEach(el => {
        el.onclick = () => playAt(Number(el.dataset.i));
      });
    }

    function playAt(i) {
      index = i;
      audio.src = tracks[i].url;
      audio.play();
      title.textContent = tracks[i].name;
      artist.textContent = "Local file";
      playBtn.textContent = "❚❚";
      render();
    }

    playBtn.onclick = () => {
      if (!audio.src) return;
      if (audio.paused) { audio.play(); playBtn.textContent = "❚❚"; }
      else { audio.pause(); playBtn.textContent = "▶"; }
    };
    document.getElementById("prev").onclick = () => { if (index > 0) playAt(index - 1); };
    document.getElementById("next").onclick = () => { if (index < tracks.length - 1) playAt(index + 1); };
    audio.ontimeupdate = () => {
      if (audio.duration) seek.value = (audio.currentTime / audio.duration) * 100;
    };
    seek.oninput = () => {
      if (audio.duration) audio.currentTime = (seek.value / 100) * audio.duration;
    };
    audio.onended = () => { if (index < tracks.length - 1) playAt(index + 1); };
  </script>
</body>
</html>
